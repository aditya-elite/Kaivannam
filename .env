# SQLite for local dev. Swap DATABASE_URL for Postgres in production — no app code changes.
DATABASE_URL="file:./dev.db"

# Session signing secret. Replace in production with a long random value.
SESSION_SECRET="dev-only-change-me-kalasutra-provenance-secret-0000"

# Ledger backend selector. "local" = tamper-evident SHA-256 hash chain in SQLite (dev).
# Swap for "fabric" / "eth" etc. behind the same LedgerService interface later.
LEDGER_BACKEND="local"

# Where uploaded images are stored in dev. Production swaps to S3/GCS via storage.ts.
STORAGE_DRIVER="local"
